rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['version', 'completedLessons', 'quizzes', 'exercises', 'programs', 'labs', 'drafts', 'practiceDays', 'lastLesson', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['version', 'completedLessons', 'quizzes', 'exercises', 'programs', 'labs', 'drafts', 'practiceDays', 'lastLesson', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.completedLessons is map
        && request.resource.data.quizzes is map
        && request.resource.data.exercises is map
        && request.resource.data.programs is map
        && request.resource.data.labs is map
        && request.resource.data.drafts is map
        && request.resource.data.drafts.size() <= 100
        && request.resource.data.practiceDays is list
        && request.resource.data.practiceDays.size() <= 366
        && request.resource.data.lastLesson is string
        && request.resource.data.updatedAt is number;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
